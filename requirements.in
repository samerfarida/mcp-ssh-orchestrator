# --- Security floors (transitive deps; pinned here to keep us out of the vulnerable
# range when pip-compile resolves the lockfile). Each line cites the open
# GHSA / Dependabot alert that drove the floor. Re-evaluate on every release.
cryptography>=50.0.1,<51.0.0  # GHSA buffer-overflow / SECT subgroup / DNS name-constraint (alerts #5, #7, #8). Cap to <51.0.0 so the next major lands in its own PR.
pyjwt[crypto]>=2.13.0  # GHSA: PyJWT accepts unknown `crit` header extensions (alert #6)
pynacl>=1.6.2  # GHSA: incomplete list of disallowed inputs (alert #3)
python-multipart>=0.0.32  # GHSA: DoS via large multipart preamble/epilogue (alert #9)
python-dotenv>=1.2.2  # GHSA: symlink following in set_key (alert #10)
starlette>=1.3.1,<1.4.0  # GHSA: form DoS, URL/Host poisoning, UNC SSRF, and unsafe method dispatch (alerts #14, #25-#28)
